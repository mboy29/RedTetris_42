{
    "name": "redtetris-backend",
    "version": "1.0.0",
    "description": "Node.js backend for React.js frontend app",
    "main": "./src/server.js",
    "scripts": {
        "start": "babel-node ./src/server.js",
        "dev": "nodemon --exec babel-node ./src/server.js",
        "test": "jest --detectOpenHandles",
        "coverage": "jest --coverage"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-session": "^1.18.0",
        "express-socket.io-session": "^1.3.5",
        "socket.io": "^4.7.5",
        "socket.io-client": "^4.1.3",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@babel/cli": "^7.24.8",
        "@babel/core": "^7.25.2",
        "@babel/node": "^7.25.0",
        "@babel/preset-env": "^7.25.3",
        "jest": "^29.7.0",
        "nodemon": "^2.0.22",
        "sinon": "^18.0.0",
        "supertest": "^7.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/__tests__/**/*.test.js"
        ],
        "collectCoverage": true,
        "coverageDirectory": "./__tests__/report",
        "coverageProvider": "v8",
        "coverageThreshold": {
            "global": {
                "branches": 50,
                "functions": 70,
                "lines": 70,
                "statements": 70
            }
        },
        "coverageReporters": [
            "text",
            "html",
            "json"
        ],
        "setupFilesAfterEnv": [
            "./__tests__/jest.setup.js"
        ],
        "moduleNameMapper": {
            "^@root/(.*)$": "<rootDir>/src/$1",
            "^@routes/(.*)$": "<rootDir>/src/routes/$1",
            "^@models/(.*)$": "<rootDir>/src/models/$1",
            "^@database/(.*)$": "<rootDir>/src/database/$1",
            "^@queries/(.*)$": "<rootDir>/src/database/queries/$1",
            "^@services/(.*)$": "<rootDir>/src/services/$1"
        },
        "verbose": true
    }
}
